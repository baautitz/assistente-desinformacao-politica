# Copie para .env e preencha. O .env nunca vai para o repositório.
# Toda variável nova deve entrar aqui e na tabela do README (seção "Variáveis de ambiente").

# Token do bot, gerado pelo @BotFather no Telegram (obrigatória)
TELEGRAM_BOT_TOKEN=

# Provedor de IA compatível com a API da OpenAI (OpenAI, OpenRouter, Groq, Ollama...)
# IA_URL_BASE, IA_CHAVE e IA_MODELO_TEXTO são obrigatórias
IA_URL_BASE=https://api.openai.com/v1
IA_CHAVE=
IA_MODELO_TEXTO=gpt-4o-mini
# Opcional: campos extras (JSON) enviados em toda chamada de chat, para opções que só alguns provedores aceitam.
# Vale só para as etapas rápidas (extrair, buscar, conferir). Ex.: no MiniMax, desligar o raciocínio deixa a chamada de ~60s em ~2s: {"thinking":{"type":"disabled"}}
# Vazio = não envia nada. Outros provedores podem recusar campos que não conhecem.
IA_CAMPOS_EXTRAS=
# Opcional: campos extras só para a etapa que escreve o resumo. Vazio = o modelo raciocina normalmente (mais lento, resumo melhor).
# Se o provedor aceitar, dá para limitar o raciocínio, ex.: {"reasoning_effort":"low"}
IA_CAMPOS_EXTRAS_REDATOR=
# Opcional: modelo de visão para ler prints. Vazio = o bot responde que só lê texto.
IA_MODELO_VISAO=

# Opcional: modelo de embeddings (mesmo provedor acima) para a busca por sentido nas matérias.
# Vazio = a busca nas matérias usa só texto. Se trocar de modelo, as matérias já coletadas deixam de entrar na busca por sentido.
IA_MODELO_EMBEDDINGS=

# Google Fact Check Tools API (chave obrigatória; idioma é opcional, padrão pt-BR)
GOOGLE_FACT_CHECK_API_KEY=
FACT_CHECK_IDIOMA=pt-BR

# Coleta de RSS (feeds em src/AssistenteDesinformacao.Bot/fontes.yaml)
COLETA_JANELA_DIAS=90
COLETA_INTERVALO_MINUTOS=60
# Opcional: caminho de outro arquivo de feeds. Vazio = usa o fontes.yaml que vai junto do bot.
# No Docker, o arquivo precisa estar montado no container.
FONTES_ARQUIVO=

# Opcional, só para testes: conexão de um Postgres DESCARTÁVEL (o teste recria o banco). Vazio = pula o teste.
TESTE_POSTGRES=

# Opcional: seu ID numérico do Telegram. Só quem tem esse ID pode usar /metricas (contagens agregadas, sem texto). Vazio = o comando não existe.
ADMIN_TELEGRAM_ID=

# Consultas por minuto permitidas a cada usuário (padrão 5)
LIMITE_CONSULTAS_POR_MINUTO=5

# Postgres (usadas pelo docker compose; obrigatórias)
POSTGRES_USER=bot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=desinformacao
