# Copie para .env e preencha. O .env nunca vai para o repositório.
# Toda variável nova deve entrar aqui e na tabela do README (seção "Variáveis de ambiente").

# Token do bot, gerado pelo @BotFather no Telegram (obrigatória)
TELEGRAM_BOT_TOKEN=

# Provedor de IA compatível com a API da OpenAI (OpenAI, OpenRouter, Groq, Ollama...)
# IA_URL_BASE, IA_CHAVE e IA_MODELO_TEXTO são obrigatórias
IA_URL_BASE=https://api.openai.com/v1
IA_CHAVE=
IA_MODELO_TEXTO=gpt-4o-mini
# Opcional: modelo de visão para ler prints. Vazio = o bot responde que só lê texto.
IA_MODELO_VISAO=

# Google Fact Check Tools API (chave obrigatória; idioma é opcional, padrão pt-BR)
GOOGLE_FACT_CHECK_API_KEY=
FACT_CHECK_IDIOMA=pt-BR

# Consultas por minuto permitidas a cada usuário (padrão 5)
LIMITE_CONSULTAS_POR_MINUTO=5

# Postgres (usadas pelo docker compose; obrigatórias)
POSTGRES_USER=bot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=desinformacao
